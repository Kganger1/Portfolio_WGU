    <worksheet name='IBM Addon Services'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#c85200' fontname='Tableau Bold' fontsize='12'>IBM Telecom</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#c85200' fontname='Tableau Regular' fontsize='10'>Impact of Family Status on Add-on Services</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='churn.csv+ (Multiple Connections)' name='federated.1uhpbvg0b9x44w1ajuccz00d9g4d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select IBM Service' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;IBM Online Backup&quot;'>
              <calculation class='tableau' formula='&quot;IBM Online Backup&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uhpbvg0b9x44w1ajuccz00d9g4d'>
            <column caption='Selected IBM Service' datatype='string' name='[Calculation_1003176875455516674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;IBM Device Protection&apos; AND [Device_Protection] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;IBM Online Backup&apos; AND [Online_Backup] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;IBM Online Security&apos; AND [Online_Security] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;IBM Streaming Movies&apos; AND [Streaming_Movies] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;IBM Streaming TV&apos; AND [Streaming_TV] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;IBM Tech_Support&apos; AND [Tech_Support] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;[IBM Multiple Lines]&apos; AND [Multiple_Lines] = &apos;Yes&apos; THEN &quot;Selected&quot;&#13;&#10;ELSE &quot;Not Selected&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Churn (tsi.csv)]' role='dimension' type='nominal' />
            <column datatype='string' name='[CustomerID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Dependents]' role='dimension' type='nominal' />
            <column datatype='string' name='[Device_Protection]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender (tsi.csv)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Internet_Service]' role='dimension' type='nominal' />
            <column datatype='string' name='[Multiple_Lines]' role='dimension' type='nominal' />
            <column datatype='string' name='[Online_Backup]' role='dimension' type='nominal' />
            <column datatype='string' name='[Online_Security]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column datatype='string' name='[Streaming_Movies]' role='dimension' type='nominal' />
            <column datatype='string' name='[Streaming_TV]' role='dimension' type='nominal' />
            <column datatype='string' name='[Tech_Support]' role='dimension' type='nominal' />
            <column-instance column='[CustomerID]' derivation='CountD' name='[ctd:CustomerID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CustomerID]' derivation='CountD' name='[diff:ctd:CustomerID:qk:1]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-field='[federated.1uhpbvg0b9x44w1ajuccz00d9g4d].[none:Dependents:nk]' ordering-type='Field' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
